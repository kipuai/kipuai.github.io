---
interface Props {
  size?: number;
  weight?: 'light' | 'regular' | 'medium';
}

const { size = 64, weight = 'regular' } = Astro.props;

const weights = {
  light:   { cord: 0.030, pendant: 0.022, dot: 0.038 },
  regular: { cord: 0.042, pendant: 0.030, dot: 0.048 },
  medium:  { cord: 0.058, pendant: 0.042, dot: 0.060 },
};
const w = weights[weight];

// Fixed 64-unit grid; width/height attrs scale the render
const S = 64;
const cordW = S * w.cord;
const pendW = S * w.pendant;
const dotR  = S * w.dot;
const topY  = S * 0.215;
const cordL = S * 0.10;
const cordR = S * 0.90;

const pendants = [
  { x: S * 0.285, endY: S * 0.595 },
  { x: S * 0.500, endY: S * 0.780 },
  { x: S * 0.715, endY: S * 0.465 },
];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <line
    x1={cordL} y1={topY} x2={cordR} y2={topY}
    stroke="currentColor" stroke-width={cordW} stroke-linecap="round"
  />
  {pendants.map(p => (
    <g>
      <line
        x1={p.x} y1={topY} x2={p.x} y2={p.endY}
        stroke="currentColor" stroke-width={pendW} stroke-linecap="round"
      />
      <circle cx={p.x} cy={p.endY} r={dotR} fill="currentColor" />
    </g>
  ))}
</svg>
